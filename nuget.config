<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Restore from nuget.org only, whatever sources or mappings the machine's own NuGet config adds.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

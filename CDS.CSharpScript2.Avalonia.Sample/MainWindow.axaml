<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="using:CDS.CSharpScript2.AvaloniaEditor"
        x:Class="CDS.CSharpScript2.Avalonia.Sample.MainWindow"
        Title="CDS C# Script — Avalonia Sample"
        Width="1000" Height="700">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="E_xit" Click="OnExitClick" />
      </MenuItem>
      <MenuItem Header="_Script">
        <MenuItem Header="_Run" InputGesture="F5" HotKey="F5" Click="OnRunClick" />
      </MenuItem>
      <MenuItem Header="_View">
        <!-- Display-only gesture: the editor handles F1 itself; on a Mac F1 needs the fn key. -->
        <MenuItem Header="_Docs" InputGesture="F1" Click="OnDocsClick" />
        <MenuItem Header="_Theme">
          <MenuItem x:Name="ThemeSystemItem" Header="_System" ToggleType="Radio" GroupName="Theme"
                    IsChecked="True" Click="OnThemeSystemClick" />
          <MenuItem x:Name="ThemeLightItem" Header="_Light" ToggleType="Radio" GroupName="Theme"
                    Click="OnThemeLightClick" />
          <MenuItem x:Name="ThemeDarkItem" Header="_Dark" ToggleType="Radio" GroupName="Theme"
                    Click="OnThemeDarkClick" />
        </MenuItem>
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Bottom" Padding="8,3"
            BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <TextBlock x:Name="StatusText" Text="Analysing…" />
    </Border>

    <Grid ColumnDefinitions="*,Auto">
      <Grid Grid.Column="0" RowDefinitions="3*,Auto,*">
        <editor:AvaloniaScriptEditor x:Name="ScriptEditor" Grid.Row="0" />

        <GridSplitter Grid.Row="1" Height="5" ResizeDirection="Rows" />

        <TabControl x:Name="BottomTabs" Grid.Row="2" Padding="0">
          <TabItem Header="Output" FontSize="14">
            <TextBox x:Name="OutputBox"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     FontFamily="Cascadia Mono, Menlo, Consolas, monospace" />
          </TabItem>
          <TabItem x:Name="ProblemsTab" Header="Problems" FontSize="14">
            <ListBox x:Name="ProblemsList"
                     FontFamily="Cascadia Mono, Menlo, Consolas, monospace" />
          </TabItem>
        </TabControl>
      </Grid>

      <!-- The docs panel: hidden until F1; MainWindow.axaml.cs shows and hides it. -->
      <editor:DocsPanel x:Name="DocsPanel" Grid.Column="1" Width="340" IsVisible="False" />
    </Grid>
  </DockPanel>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="using:CDS.CSharpScript2.AvaloniaEditor"
        x:Class="CDS.CSharpScript2.Avalonia.Sample.MainWindow"
        Title="CDS C# Script — Avalonia Sample"
        Width="1000" Height="700">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="E_xit" Click="OnExitClick" />
      </MenuItem>
    </Menu>

    <Grid RowDefinitions="3*,Auto,*">
      <editor:AvaloniaScriptEditor x:Name="ScriptEditor" Grid.Row="0" />

      <GridSplitter Grid.Row="1" Height="5" ResizeDirection="Rows" />

      <DockPanel Grid.Row="2">
        <TextBlock DockPanel.Dock="Top" Text="Output" Margin="6,4" FontWeight="SemiBold" />
        <TextBox x:Name="OutputBox"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Cascadia Mono, Menlo, Consolas, monospace" />
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>

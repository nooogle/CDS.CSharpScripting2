<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cross-platform (.NET 10 only) UI tests for the Avalonia editor. Runs the real sample
       window under Avalonia.Headless, so it needs no display and works on macOS, Linux and
       Windows, including CI. Uses the classic VSTest runner, like UnitTests, so a plain
       `dotnet test` on this project works. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CDS.CSharpScript2.Avalonia.Sample\CDS.CSharpScript2.Avalonia.Sample.csproj" />
  </ItemGroup>

</Project>
